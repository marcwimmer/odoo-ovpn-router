<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_ovpn_site_password_mail_form" model="ir.ui.view">
      <field name="name">ovpn.site.password.mail form</field>
      <field name="model">ovpn.site.password.mail</field>
      <field name="arch" type="xml">
        <form string="Passwort per Mail senden">
          <field name="site_id" invisible="1"/>
          <div class="alert alert-info" role="alert">
            Das Passwort steht nicht im Text, sondern wird beim Senden anstelle von
            <code>{password}</code> eingesetzt. <code>{site}</code> wird durch den
            Site-Namen ersetzt. Jeder Empf&#xE4;nger bekommt eine eigene Mail.
          </div>
          <group>
            <group string="Empf&#xE4;nger">
              <field name="member_ids" widget="many2many_tags" options="{'no_create': True}"/>
              <field name="partner_ids" widget="many2many_tags"/>
              <field name="extra_emails" placeholder="max@example.com, info@example.com"/>
            </group>
            <group string="Geht raus an">
              <field name="recipient_preview" nolabel="1" colspan="2" readonly="1"/>
            </group>
          </group>
          <group>
            <field name="subject"/>
          </group>
          <field name="body" nolabel="1" colspan="2"/>
          <footer>
            <button name="action_send" type="object" string="Senden" class="btn-primary"/>
            <button string="Abbrechen" class="btn-secondary" special="cancel"/>
          </footer>
        </form>
      </field>
    </record>
  </data>
</odoo>
