<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="ovpn_member_form" model="ir.ui.view">
      <field name="name">ovpn.member form</field>
      <field name="model">ovpn.member</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
            <button name="download" string="Download" icon="fa-download" type="object" class="btn-primary"/>
            <button name="generate_wg_deploy_link" string="WireGuard Deploy Link" icon="fa-terminal" type="object" attrs="{'invisible': [('wg_private_key', '=', False)]}"/>
            <button name="apply_site" string="Apply to VPN Server" icon="fa-check" type="object" class="btn-secondary"/>
          </header>
          <sheet>
            <field name="active" invisible="1"/>
            <div class="alert alert-info" role="alert">
              <p>
                Der Button <b>Download</b> oben erzeugt einen frischen, einmaligen
                Zugangs-Link &#x2013; je nach <b>Auslieferungsart</b> unterschiedlich:
              </p>
              <ul>
                <li><b>Fertige .conf-Datei</b> (GUI-Clients: macOS / Windows / iPhone):
                  &#xF6;ffnet den Download-Dialog im Browser, &#xFC;ber den die
                  fertige <b>.conf</b> geladen wird.
                </li>
                <li><b>Install-Script</b> (Linux-Server): es wird <i>kein</i>
                  Download-Dialog ge&#xF6;ffnet, sondern nur der <b>lesbare Link</b>
                  unten angezeigt. Diesen auf den Ziel-Server kopieren und dort per
                  <code>curl &lt;link&gt; | bash</code> ausf&#xFC;hren.
                </li>
              </ul>
              <ul class="mb-0">
                <li><b>Ablaufdatum vorgeben</b> (optional, <i>Eingabe</i>):
                  Wunsch-Ablauf f&#xFC;r den <i>n&#xE4;chsten</i> Link. Leer lassen
                  = Standarddauer (Default 30 Minuten).
                </li>
                <li><b>Aktueller Link l&#xE4;uft ab am</b> (<i>Status, automatisch</i>):
                  tats&#xE4;chlicher Ablauf des zuletzt erzeugten Links &#x2013;
                  danach wird er ung&#xFC;ltig.
                </li>
                <li>
                  Der Abruf ist zus&#xE4;tzlich durch das
                  <b>One Time Password</b> der Site gesch&#xFC;tzt.
                </li>
                <li>
                  Jeder Klick auf <b>Download</b> erzeugt einen neuen Link und
                  macht den vorherigen ung&#xFC;ltig.
                </li>
              </ul>
            </div>
            <div class="oe_title">
              <h1>
                <field name="name" colspan="4" class="oe_inline"/>
              </h1>
            </div>
            <group string="Zugang ausliefern">
              <field name="download_expiry"/>
              <field name="delivery_mode"/>
              <separator string="Aktueller Link (zuletzt erzeugt)" colspan="2"/>
              <field name="download_link" widget="url" readonly="1" attrs="{'invisible': [('download_link', '=', False)]}"/>
              <field name="download_hash_clear_date" readonly="1"/>
              <field name="site_one_time_password" readonly="1"/>
              <field name="wg_provisioning_state"/>
            </group>
            <group string="" col="2">
              <field name="site_id" required="1"/>
              <field name="name" required="1"/>
              <field name="ip_address"/>
              <field name="bypass_network_check"/>
              <field name="partner_id"/>
              <field name="is_master"/>
              <field name="force_remote"/>
              <field name="use_wstunnel"/>
            </group>
            <group string="IP History" attrs="{'invisible': [('ip_history_ids', '=', [])]}">
              <field name="ip_history_ids" nolabel="1" colspan="2">
                <tree string="IP History" editable="0">
                  <field name="ip_address"/>
                  <field name="change_date"/>
                </tree>
              </field>
            </group>
            <group string="WireGuard" attrs="{'invisible': [('wg_private_key', '=', False)]}">
              <field name="wg_deploy_link" widget="url" attrs="{'invisible': [('wg_deploy_link', '=', False)]}"/>
              <field name="wg_deploy_hash_expiry" attrs="{'invisible': [('wg_deploy_link', '=', False)]}"/>
              <field name="wg_config" nolabel="1" colspan="2" readonly="1"/>
            </group>
            <group string="Install Script" attrs="{'invisible': [('install_script_preview', '=', False)]}">
              <field name="install_script_preview" nolabel="1" colspan="2" readonly="1" widget="ace" options="{'mode': 'sh'}"/>
            </group>
            <group string="WireGuard Keys">
              <field name="wg_public_key" readonly="1"/>
              <field name="wg_private_key" password="True"/>
              <field name="wg_preshared_key" password="True"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>
