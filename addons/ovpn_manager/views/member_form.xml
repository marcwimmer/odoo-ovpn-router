<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="ovpn_member_form" model="ir.ui.view">
      <field name="name">ovpn.member form</field>
      <field name="model">ovpn.member</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
            <button name="download" icon="fa-download" type="object"/>
            <button name="generate_temp_link" string="Download Link Now" icon="fa-link" type="object"/>
            <button name="generate_wg_deploy_link" string="WireGuard Deploy Link" icon="fa-terminal" type="object" attrs="{'invisible': [('wg_config', '=', False)]}"/>
          </header>
          <sheet>
            <field name="active" invisible="1"/>
            <div class="oe_title">
              <h1>
                <field name="name" colspan="4" class="oe_inline"/>
              </h1>
            </div>
            <group>
              <field name="download_link"/>
              <field name="download_hash_clear_date"/>
            </group>
            <group string="Temp Link (2 min, curl-friendly)" attrs="{'invisible': [('temp_download_link', '=', False)]}">
              <field name="temp_download_link" widget="url"/>
              <field name="temp_hash_expiry"/>
            </group>
            <group string="" col="2">
              <field name="site_id" required="1"/>
              <field name="name" required="1"/>
              <field name="ip_address"/>
              <field name="bypass_network_check"/>
              <field name="partner_id"/>
              <field name="is_master"/>
              <field name="force_remote"/>
            </group>
            <group string="IP History" attrs="{'invisible': [('ip_history_ids', '=', [])]}">
              <field name="ip_history_ids" nolabel="1" colspan="2">
                <tree string="IP History" editable="0">
                  <field name="ip_address"/>
                  <field name="change_date"/>
                </tree>
              </field>
            </group>
            <group string="WireGuard Deploy" attrs="{'invisible': [('wg_config', '=', False)]}">
              <field name="wg_deploy_link" widget="url" attrs="{'invisible': [('wg_deploy_link', '=', False)]}"/>
              <field name="wg_deploy_hash_expiry" attrs="{'invisible': [('wg_deploy_link', '=', False)]}"/>
            </group>
            <group string="WireGuard Config">
              <field name="wg_config" nolabel="1" colspan="2" placeholder="Paste WireGuard config here ([Interface]...)"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>
