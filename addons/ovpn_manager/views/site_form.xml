<?xml version="1.0"?>
<odoo>
  <data noupdate="0">
    <record id="view_ovpn_site_form" model="ir.ui.view">
      <field name="name">ovpn.site form</field>
      <field name="model">ovpn.site</field>
      <field name="arch" type="xml">
        <form string="">
          <header>
            <button name="generate_json" string="Apply and Restart VPN Server (connection shortly broken)" type="object"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" colspan="4" class="oe_inline"/>
              </h1>
            </div>
            <notebook>
              <page string="Members">
                <field name="member_ids" nolabel="1" context="{'default_site_id': id}"/>
              </page>
              <page string="WireGuard">
                <group>
                  <field name="wg_server_public_key"/>
                  <field name="wg_server_port"/>
                  <field name="wg_allowed_ips"/>
                </group>
                <group string="wstunnel (TCP fallback for UDP-blocked clients)">
                  <field name="wstunnel_host"/>
                  <field name="wstunnel_port"/>
                  <field name="wstunnel_path_prefix"/>
                  <field name="wstunnel_version"/>
                </group>
              </page>
              <page string="Network Settings">
                <group>
                  <field name="remote" string="Server IP"/>
                  <field name="net" string="Network"/>
                  <field name="next_ip"/>
                  <field name="next_ip_net"/>
                  <field name="wg_interface_name" string="Interface Name"/>
                  <field name="settings_file_path" string="Settings File Path"/>
                </group>
              </page>
              <page string="Download Password">
                <group>
                  <field name="one_time_password"/>
                </group>
              </page>
              <page string="Groups">
                <field name="group_ids" nolabel="1"/>
              </page>
              <page string="Generated JSON File">
                <field name="json_content"/>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>
