# Copy to .env next to compose.yml and adjust. .env is not tracked.
# Every value is optional; the default from compose.yml applies when unset.

# Compose project name (prefix of container and image name).
WG_COMPOSE_PROJECT=wireguard_zebroo
# Host folder mounted as /data: server keys, client configs, generated rules.
WG_DATA_DIR=/etc/wg.data
# Host folder with settings.json, written by the Odoo module ovpn_manager.
WG_SETTINGS_DIR=/path/to/settings
# WireGuard interface name and VPN network.
WG_IFACE=wg1
WG_NET=10.222.0.0/22
# Image target: "runtime" (default) or "debug" (adds nmap and tcpdump).
WG_BUILD_TARGET=runtime
